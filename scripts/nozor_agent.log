[SHELL] Executing: $player = "RavageurRageur"
$range = 10
$interval = 10
$duration = 120  # 2 minutes
$count = [math]::Floor($duration / $interval)

# Récupérer la position actuelle une première fois pour centre initial
$posOutput = & rcon.cmd send "/execute in minecraft:overworld run tp RavageurRageur ~ ~ ~" 2>&1
Start-Sleep -Seconds 1

for ($i = 1; $i -le $count; $i++) {
    $dx = Get-Random -Minimum (-$range) -Maximum $range
    $dz = Get-Random -Minimum (-$range) -Maximum $range
    $dy = Get-Random -Minimum -2 -Maximum 3  # petit décalage vertical pour éviter de se retrouver dans un mur

