    $cmd = "execute as $player at @s run tp @s ~$dx ~$dz"
    
    Write-Host "[$i/$count] $cmd"
    rcon.cmd send "/$cmd" 2>&1 | Out-Null
    
    if ($i -lt $count) {
        Start-Sleep -Seconds $interval
    }
}

Write-Host "Téléportation aléatoire terminée pour $player !"
